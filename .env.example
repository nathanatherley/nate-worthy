# Copy this to .env and fill in from your five accounts.

# Railway gives you this automatically once you add a Postgres database.
DATABASE_URL=postgres://user:password@host:5432/railway

# From console.anthropic.com (the key you already created).
ANTHROPIC_API_KEY=sk-ant-...

# From resend.com — API key, plus which address to send login links from.
RESEND_API_KEY=re_...
EMAIL_FROM=Nate-Worthy <onboarding@resend.dev>

# Your real domain, once DNS is pointed at Railway.
APP_URL=https://nate-worthy.com

# From Cloudflare R2 (create an API token in the R2 dashboard).
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=...
R2_SECRET_ACCESS_KEY=...
R2_BUCKET_NAME=nate-worthy-photos

NODE_ENV=production
PORT=3000
